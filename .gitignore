# Dependencies
node_modules/

# Build output
dist/
server/server
server/server.exe

# Generated code is deliberately committed (server/gen, web/src/gen) so the repo
# builds on clone without buf installed, and so the generated API is browsable.

# Editor / OS
.DS_Store
.vscode/
.idea/

# Local env overrides
.env
.env.local

# Coverage output
server/coverage.out

# The Docker build copies web/dist here to be embedded in the binary. Only
# the dev placeholder is tracked. Note this directory is NOT called `dist`:
# the bare `dist/` rule above matches at any depth and would swallow it.
server/internal/web/assets/*
!server/internal/web/assets/index.html
